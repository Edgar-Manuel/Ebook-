# Anthropic API key — required for all AI text generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API key — required for Nano Banana Pro cover generation
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the Nano Banana model (default: gemini-3-pro-image-preview)
# Use gemini-3.1-flash-image-preview for faster/cheaper generation
# NANO_BANANA_MODEL=gemini-3.1-flash-image-preview
